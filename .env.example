# Supabase Backend (optional cloud sync; app falls back to localStorage)
# Project ID: jvghdtlfwijbkhwwpdft
VITE_SUPABASE_URL="https://jvghdtlfwijbkhwwpdft.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_cBMsOY7opCsD2IXylZn43Q_eOJCGiCh"

# ── Rapid Gateway (rapidgateway.pk) — server-side only ────────────────
# Read by public/api/checkout.php for the OAuth2 token + /rapid/process-transaction
# flow (see the merchant sandbox kit). Get these from your Rapid Gateway dashboard.
# NEVER expose them to the client (no VITE_ prefix). On Hostinger set them via
# hPanel → Advanced → PHP Settings → Environment variables, or edit the
# rg_config() fallbacks inside the PHP file.
RG_MERCHANT_ID="MERCHANT_ID_FROM_RAPID_GATEWAY"
RG_CLIENT_SECRET="CLIENT_SECRET_FROM_RAPID_GATEWAY"
RG_MERCHANT_NAME="STORIUM"

# Public site URL used to build the gateway's SUCCESS/FAILURE/CHECKOUT return URLs
# (/payment/success, /payment/failure, /payment/complete).
# On Hostinger this defaults to https://storium.online inside the PHP file.
BASE_URL="https://storium.online"

# ── Optional: webhook order sync (api/webhook.php) ────────────────────
# If your Rapid Gateway account sends payment events to a webhook URL, set the
# secret below and the Supabase service role key so the webhook can mark orders
# paid in the cloud. The service role key bypasses RLS; keep it server-side only.
RG_WEBHOOK_SECRET="WEBHOOK_SECRET_FROM_RAPID_GATEWAY"
SUPABASE_URL="https://jvghdtlfwijbkhwwpdft.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="SERVICE_ROLE_KEY_FROM_SUPABASE"
# Rapid Gateway (rapidgateway.pk) — server-side only, read by public/api/checkout.php.
# Get these from your Rapid Gateway dashboard. NEVER expose them to the client
# (no VITE_ prefix). On Hostinger set them via hPanel → Advanced → PHP Settings →
# Environment variables, or edit the rg_config() fallbacks inside the PHP file.
RG_MERCHANT_ID="MERCHANT_ID_FROM_RAPID_GATEWAY"
RG_CLIENT_SECRET="CLIENT_SECRET_FROM_RAPID_GATEWAY"
RG_MERCHANT_NAME="STORIUM"

# Public site URL used to build the gateway's SUCCESS/FAILURE/CHECKOUT return pages.

VITE_SUPABASE_URL="https://jvghdtlfwijbkhwwpdft.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_cBMsOY7opCsD2IXylZn43Q_eOJCGiCh"

# ── Rapid Gateway (rapidgateway.pk) — server-side only ────────────────
# Read by public/api/checkout.php for the OAuth2 token + sandbox/process-transaction
# flow (see the merchant sandbox kit). Get these from your Rapid Gateway dashboard.
# NEVER expose them to the client (no VITE_ / NEXT_PUBLIC_ prefix). On Hostinger
# set them via hPanel → Advanced → PHP Settings → Environment variables, or edit
# the rg_config() fallbacks inside the PHP file.
RG_MERCHANT_ID="YOUR_TEST_MERCHANT_ID"
RG_CLIENT_SECRET="YOUR_TEST_CLIENT_SECRET"
RG_MERCHANT_NAME="STORIUM"

# Public site URL used to build the gateway's SUCCESS/FAILURE/CHECKOUT return URLs
# (/payment/success, /payment/failure, /payment/complete).
# On Hostinger this defaults to https://storium.online inside the PHP file.
BASE_URL="https://storium.online"

# ── Webhook order sync (api/webhook.php) — REQUIRED for payment confirmation ──
# The webhook is the ONLY source of truth for payment confirmation (never trust
# SUCCESS_URL). The signing salt below must match the TEST/Webhook settings in
# your Rapid Gateway dashboard (TEST signing salt — separate from LIVE).
# The service role key bypasses RLS; keep it server-side only.
RG_WEBHOOK_SECRET="YOUR_TEST_WEBHOOK_SIGNING_SALT"
SUPABASE_URL="https://jvghdtlfwijbkhwwpdft.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="SERVICE_ROLE_KEY_FROM_SUPABASE"